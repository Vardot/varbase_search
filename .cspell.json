{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore"
  ],
  "words": [
    "varbase",
    "Varbase",
    "Vardot",
    "vardot",
    "phpcs",
    "phpcbf",
    "drupal",
    "Drupal",
    "jsonapi",
    "langcode",
    "metatag",
    "restui",
    "oembed",
    "yoast",
    "isset",
    "sprintf",
    "Symfony",
    "KEYTYPE",
    "LANGCODE",
    "stylelint",
    "eslint",
    "browserslist",
    "nightwatch",
    "loadjs",
    "tabbable",
    "Sortable",
    "pxtorem",
    "autoprefixer",
    "terser",
    "webpack",
    "cspell",
    "modulehandler"
  ]
}
